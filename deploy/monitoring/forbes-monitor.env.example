# Copy to /home/forbes/.config/forbes-monitor.env, chmod 600, and substitute the
# actual service user's paths. A systemd --user unit must write user-owned dirs.
MONITOR_LOG_DIR=/home/forbes/.local/state/forbes-monitor/logs
MONITOR_STATE_DIR=/home/forbes/.local/state/forbes-monitor/state
MONITOR_CPU_THRESHOLD=80
MONITOR_RECOVERY_SAMPLES=3
MONITOR_ACTIVE_EVERY=4
MONITOR_TIMEOUT_SECONDS=8
MONITOR_RETENTION_DAYS=14
MONITOR_MAX_EVIDENCE_BYTES=262144
MONITOR_MAX_DIAGNOSTIC_BYTES=131072
MONITOR_VERSION=3
MONITOR_SERVICES=mysql-8_mysql forbes_app sec-forbes_app
# Example only; use the actual protected path/image/container names:
# MONITOR_DIAGNOSTICS_COMMAND=/path/to/mysql_diagnostics.sh
MYSQL_MONITOR_HOST=mysql-8_mysql
MYSQL_MONITOR_PORT=3306
MYSQL_MONITOR_USER=forbes_monitor
MYSQL_MONITOR_PASSWORD_FILE=/run/secrets/forbes_mysql_monitor_password
MYSQL_MONITOR_STATE_FILE=/home/forbes/.local/state/forbes-monitor/state/mysql-counters.json
MYSQL_MONITOR_TIMEOUT_SECONDS=5
MYSQL_MONITOR_MAX_ROWS=100
